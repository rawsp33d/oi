enum Shape {
	point
	circle(f64)
	rect(f64, f64)
	triangle(f64, f64, f64)
}

fn area(s Shape) f64 {
	match s {
		.circle(r) => 3.14159 * r * r,
		.rect(w, h) => w * h,
		else => 0.0,
	}
}

Shape.rect(3.0, 4.0)
	|> area
	|> assert($ == 12.0)

shape := Shape.triangle(3.0, 4.0, 5.0)

match shape {
	.point => {
		print("origin: {()}")
	}
	.circle(r) => {
		print("circle: {(r,)}")
	}
	.rect(w, h) => {
		print("rect: {(w h)}")
	}
	.triangle(a, b, c) => {
		print("triangle: {(a b c)}")
	}
}
