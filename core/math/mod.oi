module math

pub e :: 2.71828182845904523536028747135266249775724709369995957496696763
pub phi :: 1.61803398874989484820458683436563811772030917980576286213544862
pub pi :: 3.14159265358979323846264338327950288419716939937510582097494459
pub tau :: 6.28318530717958647692528676655900576839433879875021164194988918

## Absolute value.
pub abs[T] :: fn(x: T) T {
	if x < 0 { -x } else { x }
}

## Minimum of two values.
pub min[T] :: fn(a: T, b: T) T {
	if a < b { a } else { b }
}

## Maximum of two values.
pub max[T] :: fn(a: T, b: T) T {
	if a > b { a } else { b }
}
