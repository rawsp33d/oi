module core

# operator overloads

# comparison
pub Eq :: trait { eq: fn(self, other: Self) bool }
pub Ord :: trait { lt: fn(self, other: Self) bool }

# arithmetic
pub Neg :: trait { neg: fn(self) Self }
pub Add :: trait { add: fn(self, other: Self) Self }
pub Sub :: trait { sub: fn(self, other: Self) Self }
pub Mul :: trait { mul: fn(self, other: Self) Self }
pub Div :: trait { div: fn(self, other: Self) Self }
pub Mod :: trait { mod: fn(self, other: Self) Self }
pub Pow :: trait { pow: fn(self, other: Self) Self }

# errors

pub Error :: trait {
	message: fn(self) string
	cause :: fn(self) ?Error { none }
}

string : Error < {
	message :: fn(self) string { self }
}

## Get the zeroed value of a type.
pub zero[T] :: fn() T { z: T; z }

# annotations

pub params :: ()
pub required :: ()

pub test :: struct {
	name: string = ""
	skip: bool = false
}

pub link :: struct { name: string }
pub export :: struct { name: string = "" }

## Marks a struct as also describing a C struct.
pub c :: ()

# ffi

## An untyped pointer for C boundaries.
pub ptr :: struct (usize)

ptr :< {
	## Copy `len` bytes into an owned string.
	@unsafe
	pub string :: fn(self, len: int) string {
		unsafe rt.oi_ptr_string(self, len)
	}

	## The pointer `n` bytes further along.
	pub offset :: fn(self, n: int) ptr {
		ptr(self.0 + usize(n))
	}

	## Whether this is a null pointer.
	pub is_null :: fn(self) bool {
		self.0 == 0
	}
}
