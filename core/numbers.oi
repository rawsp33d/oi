module core

use math.{ inf }

# TODO: make max/min consts
# TODO: add max/min for all numeric types
# TODO: add and use exponent ops
# TODO: support const expressions
# TODO: support all literals (namely exponents)

int :{
	## Largest representable `int` (2^31 - 1).
	max :: fn() int { 2147483647 }

	## Smallest representable `int` (-2^31).
	min :: fn() int { -2147483647 - 1 }
}

float :{
	## Largest finite `float`.
	max :: fn() float { 1.7976931348623157e308 }

	## Smallest finite `float`.
	min :: fn() float { -1.7976931348623157e308 }

	## Smallest step between distinct `float` values near 1.0.
	epsilon :: fn() float { 2.220446049250313e-16 }

	## Whether this is NaN.
	is_nan :: fn(self) bool {
		self != self
	}

	## Whether this is positive or negative infinity.
	is_inf :: fn(self) bool {
		self == inf || self == -inf
	}
}
